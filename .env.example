APP_NAME="Tasks for Today"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# For SQLite, leave DB_DATABASE unset to use database/database.sqlite.

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log

# TSA4 mail is logged privately; no real inbox or SMTP credentials are needed.
MAIL_MAILER=log
MAIL_LOG_CHANNEL=single
MAIL_FROM_ADDRESS=noreply@example.test
MAIL_FROM_NAME="Tasks for Today"
TASK_COMPLETION_RECIPIENT=tasks@example.test
DEMO_PROFILE_USERNAME=gian.mistica
