APP_NAME="Tasks for Today"
APP_ENV=production
APP_KEY=PASTE_THE_APP_KEY_FROM_YOUR_LOCAL_ENV
APP_DEBUG=false
APP_URL=https://YOUR-TASKS-SUBDOMAIN
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=YOUR_INFINITYFREE_MYSQL_HOST
DB_PORT=3306
DB_DATABASE=YOUR_INFINITYFREE_TASKS_DATABASE
DB_USERNAME=YOUR_INFINITYFREE_MYSQL_USERNAME
DB_PASSWORD="YOUR_INFINITYFREE_MYSQL_PASSWORD"

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log

# TSA4 demonstration mail; inspect storage/logs/laravel.log privately.
MAIL_MAILER=log
MAIL_LOG_CHANNEL=single
MAIL_FROM_ADDRESS=noreply@example.test
MAIL_FROM_NAME="Tasks for Today"
TASK_COMPLETION_RECIPIENT=tasks@example.test
DEMO_PROFILE_USERNAME=gian.mistica
